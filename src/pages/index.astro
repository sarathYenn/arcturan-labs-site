---
/**
 * The home page, laid out as a manga page: a splash panel for the one shipped
 * product, a strip of small panels for the essays, a hatched panel for what is
 * being built.
 *
 * All copy and content comes from src/data/site.ts. If you are here to add a
 * product, you are in the wrong file.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { studio, shipped, building, writing } from '../data/site';

const statusLine =
  building.length > 0
    ? `${shipped.length} live · ${building.length} in progress`
    : `${shipped.length} product live · one thing at a time`;
---

<BaseLayout>
  <section class="hero">
    <div class="halftone" aria-hidden="true"></div>
    <h1>{studio.headline}</h1>
    <p class="sub">{studio.intro}</p>
    <span class="status mono"><span class="dot" aria-hidden="true"></span>{statusLine}</span>
  </section>

  <section class="sec" id="work">
    <div class="sechead">
      <span class="n mono">01</span>
      <h2>Shipped</h2>
      <span class="rule" aria-hidden="true"></span>
    </div>

    {shipped.map((p) => (
      <article class="splash">
        <div class="art" aria-hidden="true">
          <div class="tone"></div>
          <div class="frames"><i></i><i></i><i></i></div>
        </div>
        <div class="body">
          <h3>{p.name}</h3>
          <p class="dek">{p.tagline}</p>
          <dl class="facts">
            {p.facts.map((f) => (
              <div class="fact">
                <dt class="mono">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
          <a class="cta" href={p.url}>Visit {p.name} →</a>
        </div>
      </article>
    ))}
  </section>

  <section class="sec" id="writing">
    <div class="sechead">
      <span class="n mono">02</span>
      <h2>Writing</h2>
      <span class="rule" aria-hidden="true"></span>
    </div>
    <div class="strip">
      {writing.map((w, i) => (
        <a class="cell" href={`${studio.blogUrl}/posts/${w.slug}`}>
          <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
          <p>{w.title}</p>
        </a>
      ))}
    </div>
    <p class="more">
      <a href={studio.blogUrl}>All essays at blog.arcturanlabs.com →</a>
    </p>
  </section>

  <section class="sec">
    <div class="sechead">
      <span class="n mono">03</span>
      <h2>In progress</h2>
      <span class="rule" aria-hidden="true"></span>
    </div>
    <div class="wip">
      <div class="hatchfill" aria-hidden="true"></div>
      {building.length === 0 ? (
        <p>
          <strong>Nothing to announce yet.</strong> We work on one thing at a time, and say what
          it is once it exists. The essays are the running commentary in the meantime.
        </p>
      ) : (
        <ul class="wiplist">
          {building.map((p) => (
            <li><strong>{p.name}</strong> — {p.tagline}</li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* ── hero ──────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    padding: 64px 26px 52px;
    border-bottom: 2px solid var(--ink);
    overflow: hidden;
  }
  /* Halftone field, masked to a corner so it reads as screentone rather than
     wallpaper. Pure CSS: no asset to load, scales at any density. */
  .halftone {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(var(--hatch) 1.6px, transparent 1.7px);
    background-size: 11px 11px;
    -webkit-mask-image: radial-gradient(120% 90% at 92% 4%, #000 0%, transparent 62%);
    mask-image: radial-gradient(120% 90% at 92% 4%, #000 0%, transparent 62%);
  }
  .hero h1 {
    position: relative;
    margin: 0 0 18px;
    font-size: clamp(34px, 6.4vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 850;
    max-width: 15ch;
    text-wrap: balance;
  }
  .hero .sub {
    position: relative;
    margin: 0;
    color: var(--muted);
    max-width: 52ch;
    font-size: 16.5px;
  }
  .status {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 26px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--muted);
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }

  /* ── section frame ─────────────────────────────────────────────────────── */
  .sec { padding: 32px 26px; border-bottom: 2px solid var(--ink); }
  .sec:last-of-type { border-bottom: none; }

  .sechead { display: flex; align-items: baseline; gap: 12px; margin-bottom: 22px; }
  .sechead .n { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; color: var(--accent); }
  .sechead h2 {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .sechead .rule { flex: 1; height: 2px; background: var(--ink); opacity: 0.15; }

  /* ── splash panel: the shipped product ─────────────────────────────────── */
  .splash {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    border: 2px solid var(--ink);
    box-shadow: 8px 8px 0 var(--shadow);
  }
  .splash + .splash { margin-top: 28px; }

  .art { position: relative; min-height: 230px; background: var(--accent); overflow: hidden; }
  .art .tone {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(0, 0, 0, 0.28) 2px, transparent 2.1px);
    background-size: 9px 9px;
  }
  /* Stand-in panel grid. Swap for a real generated panel when there is one to show. */
  .art .frames {
    position: absolute;
    inset: 16px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 9px;
  }
  .art .frames i {
    border: 2px solid rgba(20, 17, 24, 0.85);
    background: rgba(255, 255, 255, 0.14);
  }
  .art .frames i:first-child { grid-row: 1 / 3; }

  .body { padding: 26px; border-left: 2px solid var(--ink); }
  .body h3 { margin: 0 0 5px; font-size: 24px; font-weight: 800; letter-spacing: -0.02em; }
  .dek { margin: 0 0 18px; color: var(--muted); font-size: 14.5px; }

  .facts { margin: 0 0 20px; }
  .fact { display: flex; gap: 10px; margin-bottom: 7px; }
  .fact dt {
    min-width: 74px;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .fact dd { margin: 0; font-size: 12.5px; color: var(--muted); }

  .cta {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    padding: 10px 16px;
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--inverse);
    box-shadow: 4px 4px 0 var(--accent);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .cta:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--accent); }
  .cta:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--accent); }

  /* ── essay strip ───────────────────────────────────────────────────────── */
  .strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 2px solid var(--ink);
  }
  .cell {
    padding: 16px;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    display: block;
    transition: background 0.12s ease;
  }
  .cell:hover { background: var(--hatch); }
  .cell:nth-child(3n) { border-right: none; }
  .cell:nth-child(n + 7) { border-bottom: none; }
  .num { font-size: 10px; letter-spacing: 0.12em; color: var(--accent); font-weight: 700; }
  .cell p {
    margin: 6px 0 0;
    font-size: 13.5px;
    font-weight: 620;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .more { margin: 16px 0 0; font-size: 13px; }
  .more a { color: var(--muted); border-bottom: 1.5px solid var(--hair); }
  .more a:hover { color: var(--ink); border-color: var(--accent); }

  /* ── in progress ───────────────────────────────────────────────────────── */
  .wip { border: 2px dashed var(--ink); padding: 24px; position: relative; overflow: hidden; }
  .hatchfill {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(45deg, var(--hatch) 0 6px, transparent 6px 13px);
  }
  .wip p, .wip .wiplist { position: relative; margin: 0; color: var(--muted); max-width: 62ch; }
  .wip strong { color: var(--ink); }
  .wiplist { padding-left: 20px; }
  .wiplist li { margin: 6px 0; }

  /* ── narrow ────────────────────────────────────────────────────────────── */
  @media (max-width: 760px) {
    .hero { padding: 44px 18px 38px; }
    .sec { padding: 26px 18px; }
    .splash { grid-template-columns: 1fr; box-shadow: 5px 5px 0 var(--shadow); }
    .body { border-left: none; border-top: 2px solid var(--ink); padding: 22px; }
    .strip { grid-template-columns: 1fr 1fr; }
    .cell:nth-child(3n) { border-right: 2px solid var(--ink); }
    .cell:nth-child(2n) { border-right: none; }
    .cell:nth-child(n + 7) { border-bottom: 2px solid var(--ink); }
    .cell:nth-child(n + 9) { border-bottom: none; }
  }
</style>
