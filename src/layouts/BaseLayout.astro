---
/**
 * Shell for every page: head, ink tokens, nav, footer.
 *
 * Design language is manga-page grammar — panels, gutters, halftone, hard ink
 * rules — taken from what the studio builds rather than invented. Both themes
 * are first-class: manga is ink on paper, so light is arguably the truer mode,
 * and the tokens flip rather than the components.
 *
 * Styling is scoped `<style>` per component with tokens on :root, matching the
 * blog repo's convention so the two sites can share decisions.
 */
import { studio } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = studio.name,
  description = studio.intro,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/og-cover.jpg', Astro.site)} />
    <meta name="theme-color" content="#12305a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <style is:global>
      /* Light is the default: ink on paper. */
      :root {
        --ground: #fbfaf8;
        --panel: #ffffff;
        --ink: #141118;         /* rules, borders, primary text */
        --inverse: #f3f0eb;     /* text on ink-filled surfaces */
        --muted: #5d5766;
        --hair: #dcd7d0;
        /* Both taken off the logo. --accent is darkened from the mark's cyan so
           it clears 4.5:1 on paper — it is used at 10–11px, where the mark's own
           value would fail. */
        --accent: #0d7f9e;
        --deep: #12305a;
        --shadow: #141118;
        --hatch: rgba(20, 17, 24, 0.1);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --ground: #121016;
          --panel: #1a1721;
          --ink: #f3f0eb;
          --inverse: #141118;
          --muted: #9c94a8;
          --hair: #2c2733;
          /* Ink-on-paper inverts, so the pair does too: the cyan brightens back
             toward the mark's own value, and the navy lifts off the ground it
             would otherwise sink into. */
          --accent: #2ec4e0;
          --deep: #1b4670;
          --shadow: #000000;
          --hatch: rgba(243, 240, 235, 0.09);
        }
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: var(--ground);
        color: var(--ink);
        font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, 'SF Pro Text',
          system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      /* Panel numbers, section labels, anything annotative. */
      .mono {
        font-family: ui-monospace, 'SF Mono', Menlo, monospace;
        font-variant-numeric: tabular-nums;
      }

      a { color: inherit; text-decoration: none; }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { transition: none !important; animation: none !important; }
      }
    </style>
  </head>

  <body>
    <div class="shell">
      <nav>
        <a href="/" class="mark">
          <img class="glyph" src="/logo.png" alt="" width="40" height="40" />
          <span>{studio.name}</span>
        </a>
        <div class="links">
          <a href="#work">Work</a>
          <a href="#writing">Writing</a>
          <a href={`mailto:${studio.email}`}>Contact</a>
        </div>
      </nav>

      <slot />

      <footer>
        <span>{studio.legalName} · {studio.location}</span>
        <span class="foot-links">
          <a href={`mailto:${studio.email}`}>{studio.email}</a>
          <a href={studio.blogUrl}>blog.arcturanlabs.com</a>
        </span>
      </footer>
    </div>
  </body>
</html>

<style>
  .shell {
    max-width: 1080px;
    margin: 0 auto;
    border-left: 2px solid var(--ink);
    border-right: 2px solid var(--ink);
    background: var(--panel);
    min-height: 100vh;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 26px;
    border-bottom: 2px solid var(--ink);
  }

  .mark {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 16px;
    letter-spacing: -0.02em;
  }

  /* 40px, not the 25px the old lettered glyph used: the orbit rings and the
     molecular cluster collapse into noise below ~40, and the mark is served at
     128px so it stays sharp on dense displays. It sits unframed — a 2px rule
     around a mark that already has its own silhouette reads as a sticker. */
  .glyph {
    width: 40px;
    height: 40px;
    display: block;
    flex: none;
  }

  .links {
    display: flex;
    gap: 22px;
    font-size: 13.5px;
    color: var(--muted);
  }
  .links a:hover { color: var(--ink); }

  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    padding: 22px 26px;
    border-top: 2px solid var(--ink);
    font-size: 12.5px;
    color: var(--muted);
  }
  .foot-links { display: flex; gap: 18px; flex-wrap: wrap; }
  .foot-links a:hover { color: var(--ink); }

  @media (max-width: 720px) {
    .shell { border-left: none; border-right: none; }
    nav { padding: 14px 18px; }
    footer { padding: 18px; }
  }

  /* Below this the wordmark and three links cannot share a row without the
     wordmark wrapping and "Contact" running off the edge. The mark carries the
     identity on its own here; the name stays in the accessibility tree so the
     home link keeps a usable name. */
  @media (max-width: 430px) {
    .mark span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .links { gap: 16px; }
  }
</style>
